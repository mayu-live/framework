:ruby
  def initialize
    @id = "checkbox-#{SecureRandom.alphanumeric}"
  end

%div{class: [:group, $group_class]}
  %input(id=@id class=$class){
    type: "checkbox",
    placeholder: $label,
    **$*.except(:label),
  }
  %label(for=@id)
    = $label

:css
  .group {
    position: relative;
    margin: 1em 0;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.75em;
  }

  input {
    margin: 0;
    width: 1.25em;
    height: 1.25em;
    accent-color: var(--accent);
    cursor: pointer;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  label {
    cursor: pointer;
    color: var(--text);
  }
