%button{style: { __button_color: $color || "var(--button-background)" }, **$*.except(:color)}
  %slot

:css
  @layer form {
    button {
      background-color: var(--button-color, var(--button-background));
      border: 0;
      border-radius: var(--radius-sm);
      padding: 0.6em 1.2em;
      cursor: pointer;
      user-select: none;
      font: inherit;
      font-family: var(--font-heading);
      font-weight: 500;
      color: var(--button-text);
      box-shadow: var(--shadow);
      transition: filter 120ms, box-shadow 120ms;
    }

    button:not(:disabled):hover {
      filter: brightness(108%);
    }

    button:not(:disabled):active {
      filter: brightness(92%);
      box-shadow: none;
    }

    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    button:disabled {
      background-color: var(--gray);
      color: var(--surface);
      cursor: not-allowed;
    }
  }
