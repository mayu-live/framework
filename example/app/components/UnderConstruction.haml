:ruby
  Icon = import("/components/UI/Icon/Icon")
  Link = import("/components/UI/Link")
  Card = import("/components/UI/Card")

%Card
  .flex
    %p
      %Icon(name="person-digging" color="#1f254c")
      %span This page is under construction!
    = if $path
      %p
        %Icon(name="github" color="#1f254c")
        %Link(href="https://github.com/mayu-live/framework/blob/main/example/app/pages#{$path}/+page.haml" target="_blank")
          Edit on GitHub
:css
  Card {
    margin: 1.5em 0;
    color: #1f254c;
    --card-background: var(--sun);
    --card-border: transparent;
  }

  .flex {
    display: flex;
    justify-content: space-between;
  }

  p {
    display: inline-flex;
    gap: 1em;
    margin: 1em;
    align-items: center;
    font-size: .8em;
  }

  Icon {
    font-size: 2em;
  }
