:ruby
  MaxWidth = import("./MaxWidth")

.layout
  %nav
    .sticky
      %slot(name="menu")
  .main
    .breadcrumbs
      %slot(name="breadcrumbs")
    %MaxWidth#page
      %slot

:css
  .layout {
    height: 100%;
    position: relative;
    display: grid;
    grid-template:
      "menu" auto
      "content" 1fr;
  }

  nav {
    font-family: var(--font-heading);
    grid-area: menu;
    background: var(--menu-background);
    color: var(--menu-color);
    border-bottom: var(--thin-border);
  }

  .main {
    grid-area: content;
    min-width: 0;
  }

  MaxWidth {
    display: grid;
    padding: 1rem 0 4rem;
  }

  /* 60rem + 15rem + 4rem = 79rem */
  @media (min-width: 79rem) {
    .layout {
      grid-template:
        "menu content" 1fr
        / 15rem 1fr;
    }

    nav {
      border-bottom: 0;
      border-right: var(--thin-border);
      container-type: inline-size;
    }

    .sticky {
      position: sticky;
      top: 3.5rem;
      max-height: calc(100dvh - 3.5rem);
      overflow-y: auto;
      scrollbar-width: thin;
      padding: .5rem 0 1rem;
    }
  }

  .breadcrumbs:empty {
    display: none;
  }
