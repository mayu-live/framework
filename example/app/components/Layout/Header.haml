:ruby
  Icon = import("/components/UI/Icon/Icon")
  Logo = import("./logo.svg")
  ThemeSwitcher = import("./ThemeSwitcher")

%header
  %h1
    %a.title(href="/" title="Start page")
      %img.logo(src=Logo alt="")
      %span.wordmark mayu
  %nav
    %menu
      %li
        %a(href="/demos")
          Demos
      %li
        %a(href="/docs")
          Docs
      %li
        %a(href="https://github.com/mayu-live/framework" target="_blank")
          GitHub
          %Icon(name="up-right-from-square")
      %li.switcher
        %ThemeSwitcher

:css
  header {
    grid-row: 1;
    grid-column: 1;
    align-self: start;
    z-index: 2;
    position: sticky;
    top: 0;

    font-size: clamp(0.8rem, 3.5vw, 1rem);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1em;
    /* Fixed height so sticky elements below can line up exactly under it. */
    height: var(--header-height);
    padding: 0 1.5em;
    background: var(--header-background);
    border-bottom: 1px solid var(--chrome-border);
    box-shadow: var(--shadow-bar);
    backdrop-filter: blur(1rem) saturate(140%);
    color: var(--chrome-color);
  }

  menu {
    font-family: var(--font-heading);
    font-weight: 500;
    list-style-type: none;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: .25em;
    margin: 0;
    padding: 0;

    & a {
      &:any-link {
        display: inline-flex;
        place-items: center;
        white-space: nowrap;
        gap: 0.5em;
        padding: .4em;
        text-decoration: none;
        color: var(--header-link-color);
        transition: color 120ms;
      }

      &:is(:active, :hover, :focus-visible) {
        color: var(--header-link-hover-color);
      }
    }
  }

  .switcher {
    margin-left: .75em;
  }

  h1 {
    font-size: 1em;
    padding: 0;
    margin: 0;
    display: flex;
  }

  .title {
    display: grid;
    grid-template-columns: auto auto;
    gap: .5em;
    align-items: center;
    text-decoration: none;
  }

  .logo {
    height: 2.25em;
    width: auto;
    filter: drop-shadow(0 1px 2px oklch(0% 0 0 / 40%));
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.8em;
    letter-spacing: -0.02em;
    color: var(--pink-soft);
    transition: color 120ms;
    text-box: trim-both ex alphabetic;
  }

  .title:hover .wordmark {
    color: #fff;
  }
