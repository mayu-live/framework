:ruby
  Badge = import("./Footer/Badge")

  BADGES = [
    {
      href: "https://github.com/mayu-live/framework/search?l=Ruby&type=code",
      alt: "top language",
      src: "https://img.shields.io/github/languages/top/mayu-live/framework",
    }, {
      href: "https://github.com/mayu-live/framework/actions/workflows/test.yml",
      alt: "tests",
      src: "https://img.shields.io/github/actions/workflow/status/mayu-live/framework/.github/workflows/test.yml?branch=main&label=tests",
    }, {
      href: "https://github.com/mayu-live/framework/releases",
      alt: "Release",
      src: "https://img.shields.io/github/v/release/mayu-live/framework?sort=semver",
    }, {
      href: "https://github.com/mayu-live/framework/blob/main/COPYING",
      alt: "License: MPL-2.0",
      src: "https://img.shields.io/github/license/mayu-live/framework",
    }, {
      href: "https://status.mayu.live/",
      alt: "uptime status",
      src: "https://img.shields.io/badge/uptime-up-green",
    }, {
      href: "https://github.com/mayu-live/framework/stargazers",
      alt: "GitHub Stars",
      src: "https://img.shields.io/github/stars/mayu-live/framework?style=social",
    }
  ]

%footer
  %p
    Copyright ©
    %a(href="https://github.com/mayu-live" target="_blank")<
      github.com/mayu-live

  %dl.versions
    %dt Mayu
    %dd #{::Mayu::VERSION}
    %dt Ruby
    %dd #{::RUBY_VERSION}
    %dt YJIT
    %dd
      = if defined?(RubyVM::YJIT)
        = RubyVM::YJIT.enabled? ? "enabled" : "disabled"
      = else
        = "Unsupported"
    %dt ZJIT
    %dd
      = if defined?(RubyVM::ZJIT)
        = RubyVM::ZJIT.enabled? ? "enabled" : "disabled"
      = else
        = "Unsupported"

  %p.badges
    = BADGES.map do |badge|
      %Badge{**badge}[badge[:src]]

:css
  footer {
    background: var(--footer-background);
    border-top: 1px solid var(--chrome-border);
    padding: 2rem 1.5rem 2.5rem;
    font-size: .875rem;
    color: var(--footer-color);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  footer > * {
    margin: 0;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: 0.5em;
    opacity: .85;
  }

  a:any-link {
    color: var(--pink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:is(:active, :hover) {
    text-decoration: underline;
    color: #fff;
  }

  .versions {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem 0;
    font-family: var(--font-mono);
    font-size: .8rem;

    & :is(dt, dd) {
      display: inline;
      margin: 0;
      padding: 0;
    }

    & dt {
      color: var(--chrome-color);
      margin-right: .5ch;
    }

    & dd {
      margin-right: 1.25rem;
    }
  }
