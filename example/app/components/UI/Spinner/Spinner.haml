%i(class=$class)

:css
  i {
    display: inline-block;
    aspect-ratio: 1;
    max-width: 10rem;
    position: relative;
    width: 1.6em;

    &::after {
      display: block;
      content: "";
      position: absolute;
      inset: 0;
      mask-image: url("./90-ring-with-bg.svg");
      mask-size: contain;
      mask-repeat: no-repeat;
      background: currentcolor;
    }
  }
