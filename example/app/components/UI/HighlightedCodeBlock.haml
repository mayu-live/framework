:ruby
  Highlight = import("./Highlight")

- highlight_props = $*.except(:language, :flush)
- highlight_style = {margin: 0} if $flush

.container{ class: $flush && :flush }
  .card
    %pre
      %Highlight(language=$language style=highlight_style){**highlight_props}
        %slot

:css
  .container {
    display: grid;
  }

  .card {
    display: grid;
    background: light-dark(var(--deep-purple), var(--surface-sunken));
    border: var(--thin-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    margin: 1em;
    overflow-y: auto;
    scrollbar-width: thin;
    font-size: .9em;
  }

  .flush .card {
    min-width: 0;
    max-height: 80svh;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: auto;
  }

  pre {
    margin: 0;
    padding: 1em;
  }
