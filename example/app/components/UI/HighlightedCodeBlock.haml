:ruby
  Highlight = import("./Highlight")

.container
  .card
    %pre
      %Highlight(language=$language){**$*.except(:language)}
        %slot

:css
  .container {
    display: grid;
  }

  .card {
    display: grid;
    background: var(--deep-purple);
    border-radius: 2px;
    box-shadow: rgba(50, 50, 93, 0.55) 0px 13px 27px -5px, rgba(0, 0, 0, 0.9) 0px 8px 16px -8px;
    margin: 1em;
    overflow-y: auto;
  }

  pre {
    margin: 0;
    padding: 1em;
  }
