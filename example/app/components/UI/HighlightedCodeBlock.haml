:ruby
  Highlight = import("./Highlight")

.container
  .card
    %pre
      %Highlight(language=$language){**$*.except(:language)}
        %slot

:css
  .container {
    display: grid;
  }

  .card {
    display: grid;
    background: light-dark(var(--deep-purple), var(--surface-sunken));
    border: var(--thin-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    margin: 1em;
    overflow-y: auto;
    scrollbar-width: thin;
    font-size: .9em;
  }

  pre {
    margin: 0;
    padding: 1em;
  }
