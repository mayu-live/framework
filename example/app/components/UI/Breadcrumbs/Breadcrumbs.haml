:ruby
  Link = import("./Link")
  Separator = import("./Separator")

  def add_separators(items)
    items.map.with_index do |(path, text), index|
      if index.zero?
        { path:, text: }
      else
        [:sep, { path:, text: }]
      end
    end.flatten
  end

%nav{ aria: { label: "Breadcrumbs" } }
  %ol
    = add_separators($links).map.with_index do |elem, i|
      %li[i]
        = if elem == :sep
          %Separator
        = else
          %Link{**elem}

:css
  nav {
    font-family: var(--font-heading);
    color: var(--breadcrumbs-color);
    --link-color: currentcolor;
    width: min(100% - 4rem, var(--page-max-width));
    margin-inline: auto;
  }

  ol {
    list-style-type: none;
    display: flex;
    flex-wrap: wrap;
    gap: .25em .5em;
    align-items: center;
    font-size: .9rem;
    font-weight: 500;
    margin: 0;
    padding: 1.25rem 0 0;
  }

  li {
    margin: 0;
    padding: 0;
  }

  li:last-child {
    color: var(--text);
  }
