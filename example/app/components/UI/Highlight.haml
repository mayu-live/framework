:ruby
  ::Kernel.require("rouge")

  SUPPORTED_LEXERS = {
    "css" => Rouge::Lexers::CSS,
    "haml" => Rouge::Lexers::Haml,
    "html" => Rouge::Lexers::HTML,
    "javascript" => Rouge::Lexers::Javascript,
    "js" => Rouge::Lexers::Javascript,
    "json" => Rouge::Lexers::JSON,
    "jsx" => Rouge::Lexers::JSX,
    "rb" => Rouge::Lexers::Ruby,
    "ruby" => Rouge::Lexers::Ruby,
    "sh" => Rouge::Lexers::Shell,
    "shell" => Rouge::Lexers::Shell,
    "svg" => Rouge::Lexers::XML,
    "tsx" => Rouge::Lexers::TSX,
    "typescript" => Rouge::Lexers::Typescript,
    "ts" => Rouge::Lexers::Typescript
  }.freeze
  HIGHLIGHT_CACHE = {}

  def language
    $language || $class.to_s.split.find { _1.start_with?("language-") }&.delete_prefix("language-")
  end

  def highlighted_children
    lexer = SUPPORTED_LEXERS[language]
    return @__children.descriptors unless lexer

    source = @__children.descriptors.join
    HIGHLIGHT_CACHE[[language, source]] ||= lexer.lex(source).map do |token, value|
      token_class = token.shortname&.to_sym
      next value unless token_class && ClassNames.key?(token_class)

      H[:span, value, class: ClassNames[token_class]]
    end.freeze
  end

= if language
  %code.highlight{**$*.except(:language)}
    = highlighted_children
= else
  %code.inline{**$*.except(:language)}
    %slot

:css
  .inline {
    padding: .25em;
    background: var(--material-color-blue-gray-50);
    border: var(--thin-border);
    border-radius: 2px;
  }
