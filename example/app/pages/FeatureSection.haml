:ruby
  Icon = import("/components/UI/Icon/Icon")
  Link = import("/components/UI/Link")
  Heading = import("/components/Layout/Heading")
  Section = import("./Section")
  Feature = import("./Feature")

%Section
  %header
    %Heading#features(level=2) What you get
    %p.lead
      A full stack in one place: components, styling, assets, routing and a
      live connection to the browser.

  %Feature

  %p.more
    Read more on
    %Link(target="_blank" href="https://github.com/mayu-live/framework#readme")<
      GitHub
      %Icon(name="github")<

:css
  Section {
    background: light-dark(
      color-mix(in oklab, var(--sand) 22%, var(--surface)),
      color-mix(in oklab, var(--sand) 5%, var(--surface))
    );
  }

  header {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  Heading {
    margin: 0 0 .5rem;
  }

  .lead {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .more {
    margin: 2rem 0 0;
    color: var(--text-muted);
  }

  .more Icon {
    margin-left: .4em;
  }
