:ruby
  Card = import("/components/UI/Card")

  def initialize
    @count = $initial_count
  end

  def decrement_disabled =
    @count.zero?

  def handle_decrement =
    @count = (@count - 1).clamp(0, Float::INFINITY)

  def handle_increment =
    @count += 1

%Card
  %button(title="Decrement" onclick=handle_decrement disabled=decrement_disabled) －
  %output= @count
  %button(title="Increment" onclick=handle_increment) ＋

:css
  Card {
    margin: 0 auto;
    font-size: 1.5rem;
    background: var(--surface-sunken);

    display: grid;
    grid-template-columns: auto 1fr auto;
    padding: 1em;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }

  output {
    min-width: 4ch;
    font-size: 1.5em;
    text-align: center;
  }

  button {
    --transition-length: 200ms;

    display: block;
    font-size: 2em;
    font-weight: bold;
    width: 1em;
    line-height: 1;
    padding: 0;
    margin: 0;
    aspect-ratio: 1;
    scale: 1;
    background: var(--button-background);
    color: var(--button-text);
    border: 0;
    border-radius: 100vw;
    box-shadow: rgba(0, 0, 0, 0.34) 0px 2px 4px;
    cursor: pointer;

    transition:
      filter var(--transition-length),
      box-shadow var(--transition-length),
      scale var(--transition-length);

    &:hover {
      filter: brightness(110%);
      scale: 1.2;
    }

    &:active {
      filter: brightness(80%);
      box-shadow: rgba(0, 0, 0, 0.24) 0px 2px 4px;
    }

    &:disabled {
      filter: grayscale(100%);
      scale: 1;
      cursor: not--allowed;
    }
  }
