:ruby
  MaxWidth = import("/components/Layout/MaxWidth")
  Logo = import("/components/Layout/logo.svg")

  WORDS = %w[Mayu is a live updating server-side rendering web framework written in Ruby]

  def initialize
    @word = nil
  end

  def mount
    loop do
      sleep 3

      WORDS.length.times do |i|
        @word = i
        sleep 0.15
      end

      @word = nil
    end
  end

%section{data: { intro: true }}
  .background
  %MaxWidth
    .hero
      %img.mascot(src=Logo alt="The Mayu dolphin")
      .text
        .wordmark mayu
        %h1
          Reactive web pages in Ruby
        %h2
          = WORDS.map.with_index do |word, i|
            %span.word[i]{class: { active: i == @word }}= word
        .actions
          %a.primary(href="/docs/getting-started") Get started
          %a.secondary(href="/demos") See the demos
