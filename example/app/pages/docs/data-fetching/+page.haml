:ruby
  Details = import("/components/UI/Details")
  HighlightedCodeBlock = import("/components/UI/HighlightedCodeBlock")
  Pokemon = import("./Pokemon")

%head
  %title Data fetching

%article
  :markdown
    # Data fetching

    This example shows how data can be fetched with
    loading state and error handling.

  %HighlightedCodeBlock(language="haml")
