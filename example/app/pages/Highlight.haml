:ruby
  Icon = import("/components/UI/Icon/Icon")

%article
  .tile{style: { __tile: $icon_color }}
    %Icon(name=$icon)
  .content
    %h3= $title
    %slot

:css
  article {
    display: grid;
    grid-template-columns: 3.5rem auto;
    gap: 1.5rem;
    align-items: start;
  }

  h3 {
    font-size: 1.35em;
    margin: 0 0 .5em;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--tile);
    color: #fff;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 30%),
      0 10px 24px -10px color-mix(in oklab, var(--tile-shadow, oklch(0% 0 0)) 60%, transparent);
  }

  .tile Icon {
    font-size: 1.75rem;
    filter: drop-shadow(0 1px 1px oklch(0% 0 0 / 30%));
  }

  .content {
    color: var(--text-muted);
  }
