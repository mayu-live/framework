:ruby
  Icon = import("/components/UI/Icon/Icon")

%article
  .tile(data-icon=$icon)
    %Icon(name=$icon)
  .content
    %h3= $title
    %slot

:css
  article {
    display: grid;
    grid-template-columns: 3.5rem auto;
    gap: 1.5rem;
    align-items: start;
  }

  h3 {
    font-size: 1.35em;
    margin: 0 0 .5em;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    color: #fff;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 30%),
      0 10px 24px -10px color-mix(in oklab, var(--tile-shadow, oklch(0% 0 0)) 60%, transparent);

    &[data-icon="fire"] {
      background: linear-gradient(135deg in oklch, oklch(82% 0.16 80), oklch(62% 0.2 25));
    }

    &[data-icon="wand-magic-sparkles"] {
      background: linear-gradient(135deg in oklch, oklch(78% 0.12 var(--hue-pink)), oklch(58% 0.19 330));
    }

    &[data-icon="rocket"] {
      background: linear-gradient(135deg in oklch, oklch(70% 0.14 260), oklch(48% 0.18 280));
    }

    &[data-icon="code"] {
      background: linear-gradient(135deg in oklch, oklch(85% 0.17 130), oklch(58% 0.16 155));
    }
  }

  .tile Icon {
    font-size: 1.75rem;
    filter: drop-shadow(0 1px 1px oklch(0% 0 0 / 30%));
  }

  .content {
    color: var(--text-muted);
  }
