:ruby
  MaxWidth = import("/components/Layout/MaxWidth")
:css
  section {
    position: relative;
    padding: 4rem 0;
  }

  section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }
%section(class=$class)
  %MaxWidth
    %slot
