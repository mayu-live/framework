:ruby
  def should_update?(next_props)
    $* != next_props
  end

- $* => snake:, head:, food:
.cell{class: { snake:, head:, food: }}

:css
  .cell {
    aspect-ratio: 1;
    background: light-dark(oklch(96% 0.01 250), oklch(18% 0.02 250));
    transition: background-color 100ms ease;

    &.snake {
      background: light-dark(oklch(58% 0.16 155), oklch(72% 0.14 155));
    }

    &.head {
      background: light-dark(oklch(46% 0.15 155), oklch(64% 0.14 155));
    }

    &.food {
      background: light-dark(oklch(58% 0.22 20), oklch(72% 0.18 20));
    }
  }
