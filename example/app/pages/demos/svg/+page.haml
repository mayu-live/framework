:ruby
  Heading = import("/components/Layout/Heading")
  Clock = import("/components/Clock")
  Spirograph = import("./Spirograph")
  PelicanOnABicycle = import("./PelicanOnABicycle")

:css
  article {
    max-width: 64rem;
  }

  .lead {
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--surface-raised);
    border: var(--thin-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);

    & h3 {
      margin: 0;
    }

    & p {
      margin: 0;
      color: var(--text-muted);
    }
  }

  .clock {
    font-size: 0;
    width: min(100%, 16rem);
    margin: 1rem auto;
    color: var(--text);
    --face-start: light-dark(oklch(99% 0.01 85), oklch(30% 0.04 var(--hue-navy)));
    --face-end: light-dark(oklch(88% 0.05 85), oklch(18% 0.03 var(--hue-navy)));
    filter: drop-shadow(0 12px 24px light-dark(oklch(28% 0.06 var(--hue-navy) / 25%), oklch(0% 0 0 / 60%)));
  }

%article
  %Heading(level=2) SVG
  %p.lead
    SVG elements are rendered on the server like any other element.
    When state changes, only the changed attributes are patched in the browser.

  .grid
    %section.card
      %h3 Clock
      %p The hands are rotated on the server twice per second and eased with a CSS transition.
      %Clock.clock(gradient)

    %section.card
      %h3 Spirograph
      %p Each slider change recomputes the curve in Ruby and sends a new path.

      %Spirograph

    %section.card
      %h3 Pelican on a bicycle
      %p A cartoon drawn with paths, gradients and a few circles.
      %PelicanOnABicycle
