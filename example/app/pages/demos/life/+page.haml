:ruby
  Heading = import("/components/Layout/Heading")
  Fieldset = import("/components/Form/Fieldset")
  Button = import("/components/Form/Button")
  Link = import("/components/UI/Link")
  Life = import("./Life")

  MIN_SIZE = 8
  MAX_SIZE = 64
  DEFAULT_SIZE = 24

  MIN_FPS = 1
  MAX_FPS = 20
  DEFAULT_FPS = 4

  def initialize
    size = DEFAULT_SIZE
    @width = size
    @height = size
    @running = false
    @fps = DEFAULT_FPS
    @rule = "life"
    @reset_version = 0
    @randomize_version = 0
    @step_version = 0
  end

  def handle_reset
    @reset_version += 1
  end

  def handle_randomize
    @randomize_version += 1
  end

  def handle_step
    @step_version += 1
  end

  def handle_toggle_running
    @running = !@running
  end

  def handle_change_fps(event)
    event => { target: { value: } }
    @fps = value.to_i.clamp(MIN_FPS, MAX_FPS)
  end

  def handle_change_rule(event)
    event => { target: { value: } }
    @rule = value
  end

  def handle_change_width(event)
    event => { target: { value: } }
    @width = value.to_i.clamp(MIN_SIZE, MAX_SIZE)
  end

  def handle_change_height(event)
    event => { target: { value: } }
    @height = value.to_i.clamp(MIN_SIZE, MAX_SIZE)
  end

:css
  article {
    max-width: 64rem;
  }

  fieldset {
    margin-block: 1.5rem;
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .advanced-controls {
    border-top: var(--thin-border);
    margin-top: 1.25rem;
    padding-top: 1.25rem;
  }

  .advanced-controls h3 {
    font-size: 1rem;
    margin: 0 0 1rem;
  }

  .control-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .control {
    display: grid;
    gap: 0.4rem;
  }

  .control label {
    font-weight: 500;
  }

  .range-control {
    align-items: center;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr) 2.5rem;
  }

  .range-control input {
    min-width: 0;
    width: 100%;
  }

  output {
    background: var(--surface);
    border-radius: var(--radius);
    font-variant-numeric: tabular-nums;
    padding: 0.2rem 0.4rem;
    text-align: center;
  }

%article
  %Heading(level=2) Game of life

  %p
    This is an implementation of
    %Link{
      href: "https://en.wikipedia.org/wiki/Conway%27s_Game_of_Life",
      target: "_blank"
    }<
      Conway's Game of Life
    \.
  %p
    Use the primary mouse button to draw and the secondary mouse button to erase.

  %Fieldset
    %legend Controls
    .buttons
      %Button(onclick=handle_reset) Reset
      %Button(onclick=handle_randomize) Randomize
      %Button(onclick=handle_step disabled=@running) Step
      %Button(onclick=handle_toggle_running){
        color: @running ? "var(--red)" : "var(--green)"
      }
        = @running ? "Stop" : "Start"

    %section.advanced-controls(aria-labelledby="advanced-controls-heading")
      %h3(id="advanced-controls-heading") Advanced controls
      .control-grid
        .control
          %label(for="grid-width") Grid width
          .range-control
            %input(id="grid-width" type="range" min=MIN_SIZE max=MAX_SIZE step=1 oninput=handle_change_width){value: @width}
            %output(for="grid-width")= @width
        .control
          %label(for="grid-height") Grid height
          .range-control
            %input(id="grid-height" type="range" min=MIN_SIZE max=MAX_SIZE step=1 oninput=handle_change_height){value: @height}
            %output(for="grid-height")= @height
        .control
          %label(for="game-fps") Frames per second
          .range-control
            %input(id="game-fps" type="range" min=MIN_FPS max=MAX_FPS step=1 oninput=handle_change_fps){value: @fps}
            %output(for="game-fps")= @fps
        .control
          %label(for="game-rule") Rule
          %select(id="game-rule" onchange=handle_change_rule){value: @rule}
            = Life::RULES.map do |rule|
              %option(value=rule.id)= rule.name

  %Life{
    width: @width,
    height: @height,
    running: @running,
    fps: @fps,
    rule: @rule,
    reset_version: @reset_version,
    randomize_version: @randomize_version,
    step_version: @step_version,
  }
