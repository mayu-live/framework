:ruby
  def handle_context_menu
  end

  def should_update?(next_props)
    $* != next_props
  end

- $* => x:, y:, alive:, ondraw:, **rest
- value = "#{x} #{y}"

%button{
  **rest,
  value:,
  class: { alive: },
  oncontextmenu: handle_context_menu,
  onmousedown: $ondraw,
  onmouseenter: $ondraw,
}

:css
  button {
    border: 0;
    padding: 0;
    aspect-ratio: 1;
    flex: 1;
    background-color: light-dark(oklch(97% 0.008 250), oklch(17% 0.018 250));
  }

  button:hover { background-color: light-dark(oklch(88% 0.035 155), oklch(29% 0.05 155)); }

  .alive {
    background-color: light-dark(oklch(46% 0.13 155), oklch(66% 0.13 155));
  }

  .alive:hover {
    filter: brightness(112%);
  }

  button:active:hover { background-color: light-dark(oklch(38% 0.13 155), oklch(58% 0.13 155)); }
