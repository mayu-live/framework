:ruby
  Cell = import("./Cell")

:css
  .grid {
    user-select: none;
    touch-action: none;
    width: min(100%, 30rem);
    margin: 2em auto;
    padding: 2px;
    background: light-dark(oklch(54% 0.045 252), oklch(38% 0.035 252));
    border: 1px solid light-dark(oklch(45% 0.04 252), oklch(48% 0.035 252));
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }

  .row {
    display: flex;
    gap: 1px;
  }

.grid
  = $grid.map.with_index do |row, y|
    .row[y]
      = row.map.with_index do |alive, x|
        %Cell["#{x}.#{y}"]{ondraw: $ondraw, alive:, x:, y:}
