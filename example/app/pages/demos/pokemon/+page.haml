:ruby
  Spinner = import("/components/UI/Spinner/Spinner")
  Link = import("/components/UI/Link")
  Filter = import("./Filter")
  Pagination = import("./Pagination")

  def initialize
    @result = nil
    @error = nil
  end

  def mount
    sleep 1

    res = fetch("https://pokeapi.co/api/v2/pokemon?limit=100000&offset=0")
    @result = res.json(symbolize_names: true)
  rescue => e
    @error = e.message
  end

  def handle_set_per_page(e)
    e => { target: { value: } }
    # Start over on the first page with the new page size.
    browser.navigate("?per_page=#{value.to_i}", replace: true)
  end

:css
  ul {
    list-style-type: none;
  }

  li {
    list-style-type: none;
    margin: 0.5em 0;
  }

- return if @error
  %p Error: #{@error}

- return unless @result
  %div
    %p
      Loading Pokémon from
      %Link(href="https://pokeapi.co/")< PokéAPI
      \.
    %Spinner

:ruby
  @result => results:

  per_page = $query[:per_page].to_i
  per_page = 20 unless [20, 40, 80].include?(per_page)
  total_pages = (results.length / per_page).floor
  page = $query[:page].to_i.clamp(1, total_pages.succ)
  results_on_this_page = results.slice(page.pred * per_page, per_page) || []

%article
  %Filter{results:}

  %Pagination(on_change_per_page=handle_set_per_page){
    page:,
    per_page:,
    total_pages:,
    window_size: 7,
  }

  %ul
    = results_on_this_page.map do |result|
      - id = result[:url].split("/").last.to_i

      %li[result[:url]]
        = "#{id}. "
        %Link(href="/demos/pokemon/#{id}")
          = result[:name].capitalize

  %Pagination(on_change_per_page=handle_set_per_page){
    page:,
    per_page:,
    total_pages:,
    window_size: 7
  }
