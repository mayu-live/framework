:ruby
  Heading = import("/components/Layout/Heading")
  CustomElement = import("./CustomElement.tsx")

  COLORS = %w[red blue green purple teal]

  def initialize
    @color = COLORS.first
  end

  def set_color(e)
    @color = e.dig(:currentTarget, :value).to_s
  end

%article
  %Heading(level=2)
    Custom elements

  %p This is a custom element:
  %CustomElement(color=@color)

  %p And these buttons are server side:

  %fieldset
    %legend Server-side controls:
    = COLORS.map do |color|
      %label
        %input(type="radio" value=color onchange=set_color){ checked: @color == color }
        %span= color
    %label
      %input(type="color" value=@color oninput=set_color colorspace="display-p3")
      %span Choose color

:css
  fieldset {
    border: 2px solid #999;
    display: grid; justify-content: start;
    gap: 1em;
  }

  label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .5em;
    align-items: center;
    cursor: pointer;
  }

  input {
    &[type="radio"] {
      margin: 0;
    }

    &[type="color"] {
      all: unset;

      display: block;
      width: 1.4em;
      aspect-ratio: 1;
      border: 1px solid #0006;
      border-radius: 2px;

      &::-webkit-color-swatch-wrapper {
        padding: 0;
      }

      &::-moz-color-swatch {
        border: none;
      }

      &::-webkit-color-swatch {
        border: none;
      }
    }
  }
