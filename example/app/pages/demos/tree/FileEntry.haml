:ruby
  Link = import("/components/UI/Link")
  Name = import("./Name")

  def icon
    case File.extname($path)
    in ".haml" | ".css" | ".rb"
      "file-code"
    in ".md"
      "file-lines"
    in ".png" | ".jpg" | ".jpeg" | ".svg"
      "file-image"
    else
      "file"
    end
  end

  def selected? = @@selected_path == $path

  def should_update?(next_props) = $* != next_props

:css
  .selected {
    margin-inline: -.25em;
    padding-inline: .25em;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

%Name(icon=icon){class: selected? && :selected}
  %Link{href: File.join("/demos/tree", $path), aria_current: selected? && "page"}
    = File.basename($path)
