{
  "name": "@mayu-live/main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Main package.json for mayu",
  "scripts": {
    "build": "npm -w gems/mayu-live/lib/mayu/client run build:production",
    "test": "npm -w gems/mayu-live/lib/mayu/client run test",
    "test:watch": "npm -w gems/mayu-live/lib/mayu/client run test:watch",
    "format": "bundle exec standardrb --fix && npm run prettier",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,md,html,css,json,yaml,yml}'",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayu-live/prototype.git"
  },
  "author": "",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/mayu-live/prototype/issues"
  },
  "homepage": "https://github.com/mayu-live/prototype#readme",
  "workspaces": [
    "gems/mayu-live/lib/mayu/client"
  ],
  "devDependencies": {
    "husky": "^8.0.2",
    "lint-staged": "^13.1.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{rb,gemspec}": "bundle exec standardrb --fix --cache false",
    "{Gemfile,Rakefile}": "bundle exec standardrb --fix --cache false",
    "*.{js,jsx,ts,tsx,md,html,css,json,yaml,yml}": "prettier --write"
  }
}
