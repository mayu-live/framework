{
  "version": "2",
  "streamContentType": "application/vnd.mayu.event-stream",
  "commands": {
    "Initialize": ["id_tree"],
    "Resync": ["html", "id_tree"],
    "CreateTree": ["html", "tree"],
    "ReplaceChildren": ["id", "child_ids"],
    "RemoveNode": ["id"],
    "SetAttribute": ["id", "name", "value"],
    "RemoveAttribute": ["id", "name"],
    "AddClass": ["id", "classes"],
    "RemoveClass": ["id", "classes"],
    "SetListener": ["id", "name", "listener_id"],
    "RemoveListener": ["id", "name", "listener_id"],
    "SetCSSProperty": ["id", "name", "value"],
    "RemoveCSSProperty": ["id", "name"],
    "SetTextContent": ["id", "content"],
    "Transfer": ["payload"],
    "TransferFailed": [],
    "Pong": ["timestamp"],
    "ReloadSucceeded": [],
    "NavigationComplete": ["id"],
    "NavigationFailed": ["id"],
    "DocumentNavigation": ["id", "href"],
    "CallbackComplete": ["id"],
    "CallbackFailed": ["id"],
    "RegisterCustomElement": ["name", "path"],
    "BrowserAction": ["name", "args"],
    "ElementCall": ["id", "method", "args"],
    "InspectResult": ["request_id", "result"],
    "RenderError": [
      "file",
      "type",
      "message",
      "backtrace",
      "source",
      "tree_path",
      "line",
      "column",
      "hints"
    ],
    "ViewTransition": ["batch", "types", "scope"]
  },
  "events": ["Callback", "Navigate", "Ping", "Visibility", "Inspect", "Resync"],
  "errorCodes": {
    "SESSION_NOT_FOUND": { "reset": true },
    "SESSION_ID_MISMATCH": { "reset": false },
    "INVALID_TOKEN": { "reset": false },
    "TOKEN_COOKIE_NOT_SET": { "reset": true },
    "EVENT_MESSAGE_TOO_LARGE": { "reset": false },
    "INVALID_EVENT_MESSAGE": { "reset": false },
    "SESSION_NOT_ACCEPTING_EVENTS": { "reset": false },
    "INTERNAL_SERVER_ERROR": { "reset": false },
    "SESSION_RESTORE_FAILED": { "reset": true },
    "SESSION_EXPIRED": { "reset": true },
    "SESSION_CIPHER_ERROR": { "reset": true },
    "SERVER_STOPPING": { "reset": false },
    "PROTOCOL_MISMATCH": { "reset": false }
  },
  "continuousEvents": [
    "input",
    "mousemove",
    "pointermove",
    "touchmove",
    "wheel",
    "scroll",
    "drag",
    "dragover"
  ],
  "elementMethods": [
    "focus",
    "blur",
    "click",
    "select",
    "reset",
    "request_submit",
    "scroll_into_view",
    "set_selection_range",
    "show_modal",
    "show",
    "close",
    "show_popover",
    "hide_popover",
    "toggle_popover"
  ]
}
