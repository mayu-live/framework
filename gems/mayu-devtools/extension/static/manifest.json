{
  "manifest_version": 3,
  "name": "Mayu DevTools",
  "version": "0.1.0",
  "description": "Inspect the component tree of Mayu Live apps.",
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
