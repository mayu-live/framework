    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "rolldown": "^1.2.11",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
